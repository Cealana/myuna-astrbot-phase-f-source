MYUNA_ENV=dev
MYUNA_BIND_HOST=127.0.0.1
MYUNA_PORT=18081
MYUNA_DATA_DIR=/var/lib/myuna/qq
MYUNA_LOG_DIR=/var/log/myuna/qq
MYUNA_DEFINITION_RELEASE=v5-2755db85ca7e-b1-dbc4b229-g9f993b18-a95b4a017-te2e33bb3
MYUNA_DEFINITION_PATH=/srv/myuna/environments/dev/definition/current
MYUNA_CAPABILITY_MANIFEST=/etc/myuna/capabilities/qq-owner-v5.json
MYUNA_PROVIDERS_ENABLED=deepseek
MYUNA_PROVIDER_LIVE_CALLS_ENABLED=true
MYUNA_DEEPSEEK_MODEL=deepseek-v4-flash
MYUNA_DEEPSEEK_DAILY_BUDGET_USD=2.00
MYUNA_DEEPSEEK_TIMEOUT_SECONDS=60
MYUNA_DEEPSEEK_MAX_ATTEMPTS=2
MYUNA_DEV_TOKEN_CREDENTIAL=qq_owner_core_token
MYUNA_HTTP_MAX_BODY_BYTES=65536
MYUNA_MEMORY_WORKER_ENABLED=false
MYUNA_MEMORY_SYNTHETIC_ONLY=true
