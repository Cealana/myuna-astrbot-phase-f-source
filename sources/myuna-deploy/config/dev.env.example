MYUNA_ENV=dev
MYUNA_BIND_HOST=127.0.0.1
MYUNA_PORT=18080
MYUNA_DATA_DIR=/var/lib/myuna/dev
MYUNA_LOG_DIR=/var/log/myuna/dev
MYUNA_DEFINITION_RELEASE=
MYUNA_DEFINITION_PATH=
MYUNA_CAPABILITY_MANIFEST=
MYUNA_PROVIDERS_ENABLED=
MYUNA_PROVIDER_LIVE_CALLS_ENABLED=false
MYUNA_DEEPSEEK_MODEL=deepseek-v4-flash
MYUNA_DEEPSEEK_DAILY_BUDGET_USD=2.00
MYUNA_DEEPSEEK_TIMEOUT_SECONDS=60
MYUNA_DEEPSEEK_MAX_ATTEMPTS=2
MYUNA_DEV_TOKEN_CREDENTIAL=
MYUNA_HTTP_MAX_BODY_BYTES=65536
MYUNA_MEMORY_WORKER_ENABLED=false
MYUNA_MEMORY_WORKER_SOCKET=/run/myuna-retrieval-dev/worker.sock
MYUNA_MEMORY_SYNTHETIC_ONLY=true
MYUNA_MEMORY_SYNTHETIC_FIXTURE=
MYUNA_MEMORY_SYNTHETIC_FIXTURE_SHA256=
MYUNA_MEMORY_SYNTHETIC_AT=
MYUNA_DATABASE_DSN=dbname=myuna_dev user=myuna_dev_app host=/var/run/postgresql
