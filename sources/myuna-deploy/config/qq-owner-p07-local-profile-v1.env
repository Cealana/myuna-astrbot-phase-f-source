MYUNA_PROVIDERS_ENABLED=local
MYUNA_PROVIDER_LIVE_CALLS_ENABLED=true
MYUNA_LOCAL_PROVIDER_BASE_URL=http://127.0.0.1:879/v1
MYUNA_LOCAL_PROVIDER_MODEL=myuna-local-owner-v1
MYUNA_LOCAL_PROVIDER_TIMEOUT_SECONDS=120
MYUNA_CAPABILITY_MANIFEST=/etc/myuna/capabilities/qq-owner-v6-p07-local-profile-v1.json
MYUNA_OWNER_MEMORY_READ_ENABLED=false
MYUNA_OWNER_PROFILE_READ_ENABLED=true
MYUNA_OWNER_PROFILE_WORKER_SOCKET=/run/myuna-owner-profile-read-v1/profile.sock
MYUNA_OWNER_PROFILE_TIMEOUT_MS=500
MYUNA_OWNER_PROFILE_CAPABILITY_PROFILE=/etc/myuna/capabilities/owner-private-profile-read-v1.json
MYUNA_OWNER_PROFILE_PROVIDER_ALLOWLIST=local
