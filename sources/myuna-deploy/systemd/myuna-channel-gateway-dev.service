[Unit]
Description=Myuna owner challenge gateway (dev, activation gated)
Documentation=file:/srv/myuna/repos/deploy/docs/ADR-019-owner-qq-private-challenge.md
Requires=postgresql.service
After=postgresql.service
ConditionPathExists=/etc/myuna-gateway/activation-approved
ConditionPathExists=/etc/myuna-gateway/owner-challenge-v1.json

[Service]
Type=simple
User=myuna-gateway
Group=myuna-gateway
ExecStart=/usr/bin/python3 /usr/local/libexec/myuna-gateway/owner_challenge_gateway.py
Environment=PYTHONPATH=/usr/local/lib/myuna-gateway/core-v1
LoadCredential=channel-signing:/etc/myuna-gateway/secrets/channel-signing-v1
LoadCredential=identity-pepper:/etc/myuna-gateway/secrets/identity-pepper-v1
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/myuna-gateway /var/log/myuna-gateway

[Install]
WantedBy=sockets.target
