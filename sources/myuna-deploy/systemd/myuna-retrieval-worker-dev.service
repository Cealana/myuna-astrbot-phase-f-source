[Unit]
Description=Myuna synthetic retrieval worker (dev, Unix socket only)
Documentation=file:/srv/myuna/repos/embedding-lab/README.md
Requires=postgresql.service
After=postgresql.service
ConditionPathExists=/srv/myuna/models/huggingface/models--Qwen--Qwen3-Embedding-0.6B/snapshots/97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
ConditionPathExists=/srv/myuna/repos/embedding-lab/fixtures/retrieval_zh_v1.jsonl

[Service]
Type=simple
User=myuna
Group=myuna
WorkingDirectory=/srv/myuna/repos/embedding-lab
RuntimeDirectory=myuna-retrieval-dev
RuntimeDirectoryMode=0750
Environment=PYTHONUNBUFFERED=1
Environment=HF_HOME=/srv/myuna/models/huggingface
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
Environment=TOKENIZERS_PARALLELISM=false
Environment=CUDA_VISIBLE_DEVICES=
Environment=OMP_NUM_THREADS=4
Environment=MKL_NUM_THREADS=4
ExecStart=/srv/myuna/environments/embedding-bench/venv/bin/python -m myuna_embedding_lab.worker --socket /run/myuna-retrieval-dev/worker.sock --idle-seconds 60 --candidate-limit 20 --threads 4
Restart=on-failure
RestartSec=3s
TimeoutStopSec=10s
KillMode=control-group
OOMPolicy=stop
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=200%
MemoryHigh=4600M
MemoryMax=5G
TasksMax=96

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/myuna-retrieval-dev

[Install]
WantedBy=multi-user.target

