[Unit]
Description=Myuna Owner Telegram one-time challenge gateway (dev)
Documentation=file:@GATEWAY_RELEASE_ROOT@/docs/ADR-033-astrbot-telegram-owner-runtime-v1.md
Requires=postgresql.service
After=postgresql.service
ConditionPathExists=/etc/myuna-telegram-gateway/challenge-approved
ConditionPathExists=/etc/myuna-telegram-gateway/owner-challenge-v1.json

[Service]
Type=simple
User=myuna-gateway-telegram
Group=myuna-gateway-telegram
ExecStart=/usr/bin/python3 @GATEWAY_RELEASE_ROOT@/scripts/telegram_owner_challenge_gateway.py
Environment=PYTHONPATH=@CORE_RELEASE_ROOT@/src:@GATEWAY_RELEASE_ROOT@/scripts
LoadCredential=channel-signing:/etc/myuna-telegram-gateway/secrets/channel-signing-v1
LoadCredential=identity-pepper:/etc/myuna-telegram-gateway/secrets/identity-pepper-v1
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ReadWritePaths=/var/lib/myuna-telegram-gateway /var/log/myuna-telegram-gateway

[Install]
WantedBy=sockets.target
