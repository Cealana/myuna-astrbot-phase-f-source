[Unit]
Description=Myuna owner-memory metadata-only Shadow adapter (dev)
After=postgresql.service
RequiresMountsFor=/opt/myuna/owner-memory-retrieval-preview-v1
Requires=myuna-owner-memory-shadow-dev.socket

[Service]
Type=simple
User=myuna_memory_preview
Group=myuna_memory_preview
ExecStart=/usr/bin/python3 /opt/myuna/owner-memory-shadow-adapter-v1/shadow_adapter.py --trace /var/log/myuna/owner-memory-shadow/trace.jsonl
Restart=on-failure
RestartSec=2s
LogsDirectory=myuna/owner-memory-shadow
LogsDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
PrivateNetwork=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
ProcSubset=pid
ProtectProc=invisible
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
