[Unit]
Description=Myuna isolated Pillow vision decoder worker (inactive candidate)
Documentation=file:/opt/myuna/vision-decoder-worker/releases/@WORKER_RELEASE@/docs/ADR-047-vision-decoder-worker-v1.md
Requires=myuna-vision-decoder-shadow-v1.socket
After=myuna-vision-decoder-shadow-v1.socket
ConditionPathExists=/etc/myuna-gateway/vision-decoder-shadow-v1-enabled

[Service]
Type=simple
User=myuna_media_decoder
Group=myuna_media_decoder
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=/opt/myuna/vision-decoder-worker/releases/@WORKER_RELEASE@:/opt/myuna/vision-media-probe/releases/@PROBE_RELEASE@
ExecStart=/opt/myuna/vision-decoder/runtimes/pillow-12.3.0-cp312-78cb2c6865a35ab8/bin/python -m myuna_media_decoder.worker --policy /opt/myuna/vision-media-probe/releases/@PROBE_RELEASE@/config/vision-media-probe-pillow-v1.json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=5s
KillMode=control-group
OOMPolicy=stop
UMask=0077
Nice=10
CPUQuota=100%
MemoryHigh=256M
MemoryMax=384M
TasksMax=16

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
SystemCallArchitectures=native
ProcSubset=pid
ProtectProc=invisible
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
