[Unit]
Description=Myuna verified Owner Telegram private runtime socket (dev)
Documentation=file:@GATEWAY_RELEASE_ROOT@/docs/ADR-033-astrbot-telegram-owner-runtime-v1.md
ConditionPathExists=/etc/myuna-telegram-gateway/runtime-approved
ConditionPathExists=/etc/myuna-telegram-gateway/owner-runtime-v1.json

[Socket]
ListenStream=/run/myuna-telegram-gateway/owner.sock
SocketUser=root
SocketGroup=myuna-gateway-telegram
SocketMode=0660
DirectoryMode=0750
Accept=no
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
