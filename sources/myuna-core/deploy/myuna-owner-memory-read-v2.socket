[Unit]
Description=Myuna Owner Memory read-only v2 local socket
Wants=systemd-tmpfiles-setup.service
After=systemd-tmpfiles-setup.service

[Socket]
ListenStream=/run/myuna-owner-memory-read-v2/worker.sock
SocketUser=myuna_memory_runtime
SocketGroup=myuna
SocketMode=0660
DirectoryMode=0750
RemoveOnStop=true
Service=myuna-owner-memory-read-v2.service
MaxConnections=8
TriggerLimitIntervalSec=30s
TriggerLimitBurst=10

[Install]
WantedBy=sockets.target
